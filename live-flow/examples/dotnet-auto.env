# Install/configure OpenTelemetry .NET Automatic Instrumentation first.
# These settings complement its platform-specific profiler/startup-hook configuration.
OTEL_SERVICE_NAME=orders-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=shop,deployment.environment.name=prod,kafka.cluster.id=cluster-a
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_BSP_SCHEDULE_DELAY=250
OTEL_DOTNET_AUTO_TRACES_KAFKA_INSTRUMENTATION_ENABLED=true
# Pilot only: sampling inside the app removes observations before Live Flow sees them.
OTEL_TRACES_SAMPLER=always_on
# With Flow__ApiKey configured on the service, also set:
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer%20YOUR_KEY
# For an existing collector, point the app at that collector instead and fan out there.
# Do not overwrite an existing export route to Grafana Cloud.
